@namespace ThreeByThreeManager.Components.Shared
@inject IJSRuntime JS

<svg class="shot-chart" viewBox="0 0 500 470" preserveAspectRatio="xMidYMid meet"
     @ref="svgRef" @onclick="HandleClick" @attributes="AdditionalAttributes">
    <rect x="0" y="0" width="500" height="467" class="court-floor" />
    <rect x="0" y="0" width="500" height="467" class="court-outline" />

    <path d="M 30 367.3 L 30 467" class="court-line" />
    <path d="M 470 367.3 L 470 467" class="court-line" />
    <path d="M 30 367.3 A 225 225 0 0 1 470 367.3" class="court-line arc" />

    <rect x="168.3" y="273.7" width="163.3" height="193.3" class="court-line" />
    <path d="M 190 273.7 A 60 60 0 0 1 310 273.7" class="court-line arc" />
    <path d="M 208.3 467 A 41.7 41.7 0 0 1 291.7 467" class="court-line arc" />

    <line x1="220" y1="467" x2="280" y2="467" class="court-backboard" />
    <circle cx="250" cy="414.5" r="6" class="court-hoop" />

    @foreach (var shot in Shots)
    {
        var cx = shot.X * 33.333;
        var cy = 467 - shot.Y * 33.333;
        <circle cx="@cx" cy="@cy" r="5"
                class="@(shot.Made ? "shot-made" : "shot-missed")">
            <title>@(shot.IsThree ? "3PT" : "2PT") @(shot.Made ? "segnato" : "sbagliato")</title>
        </circle>
    }
</svg>

@code {
    [Parameter] public List<Shot> Shots { get; set; } = new();

    [Parameter] public bool Interactive { get; set; }

    [Parameter] public EventCallback<(double X, double Y)> OnShotPlaced { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference svgRef;

    private async Task HandleClick(MouseEventArgs e)
    {
        if (!Interactive) return;

        var point = await JS.InvokeAsync<double[]>("shotChartPoint", svgRef, e.ClientX, e.ClientY);
        if (point == null || point.Length < 2) return;

        var px = point[0];
        var py = point[1];

        var x = Math.Clamp(px / 33.333, 0, 15);
        var y = Math.Clamp((467 - py) / 33.333, 0, 14);

        await OnShotPlaced.InvokeAsync((x, y));
    }
}
