@page "/statistics"
@inject IStatsService StatsService
@inject IMatchService MatchService
@inject IPlayerService PlayerService

<PageTitle>Statistiche — Le Stelle 5x5</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h1 class="section-title">STATISTICHE</h1>
        <p class="section-subtitle mb-0">Statistiche dettagliate giocatori e partite</p>
    </div>
</div>

@if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <label class="text-label-caps text-secondary">Filtra per Giocatore</label>
            <select class="form-select urban-input" @bind="filterPlayerId" @bind:after="ApplyFilters">
                <option value="0">Tutti i giocatori</option>
                @foreach (var p in players)
                {
                    <option value="@p.Id">@p.FullName</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="text-label-caps text-secondary">Filtra per Partita</label>
            <select class="form-select urban-input" @bind="filterMatchId" @bind:after="ApplyFilters">
                <option value="0">Tutte le partite</option>
                @foreach (var m in allMatches)
                {
                    <option value="@m.Id">VS @m.Opponent — @m.DateTime.ToString("dd/MM")</option>
                }
            </select>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="table-container">
                <div class="section-header">TIRI DAL CAMPO — MAPPA E PERCENTUALI</div>
                <div class="row g-3 p-3">
                    <div class="col-md-3">
                        <label class="text-label-caps text-secondary">Giocatore</label>
                        <select class="form-select urban-input" @bind="chartPlayerId" @bind:after="LoadShotChart">
                            @foreach (var p in players)
                            {
                                <option value="@p.Id">@p.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="text-label-caps text-secondary">Partita</label>
                        <select class="form-select urban-input" @bind="chartMatchId" @bind:after="LoadShotChart">
                            <option value="0">Tutta la stagione</option>
                            @foreach (var m in allMatches.Where(m => m.Status == MatchStatus.Played))
                            {
                                <option value="@m.Id">VS @m.Opponent — @m.DateTime.ToString("dd/MM")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="d-flex gap-3 flex-wrap">
                            <div class="shot-legend">
                                <span><span class="dot made"></span>Canestro</span>
                                <span><span class="dot missed"></span>Sbagliato</span>
                            </div>
                            <div class="d-flex gap-2">
                                @foreach (var (label, value, color) in pctCards)
                                {
                                    <div class="card-stat text-center py-2 px-3">
                                        <span class="stat-label" style="font-size:9px">@label</span>
                                        <span class="stat-value d-block" style="color:@color">@value</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="px-3 pb-3">
                    <ShotChart Shots="@shotChartShots" />
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <div class="table-container">
                <div class="section-header">STATISTICHE PER PARTITA</div>
                <div class="table-responsive">
                    <table class="table-stats mb-0">
                        <thead>
                            <tr>
                                <th>Giocatore</th>
                                <th>Partita</th>
                                <th>PTS</th>
                                <th>RIM</th>
                                <th>AST</th>
                                <th>REC</th>
                                <th>STP</th>
                                <th>FAL</th>
                                <th>Eval</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in filteredStats)
                            {
                                <tr>
                                    <td class="fw-bold">@s.Player.FullName</td>
                                    <td class="text-sm">VS @s.Match.Opponent</td>
                                    <td class="fw-bold">@s.Points</td>
                                    <td>@s.Rebounds</td>
                                    <td>@s.Assists</td>
                                    <td>@s.Steals</td>
                                    <td>@s.Blocks</td>
                                    <td>@s.Fouls</td>
                                    <td class="fw-bold text-primary">@s.Evaluation.ToString("F0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-4">
        <div class="col-12">
            <div class="table-container">
                <div class="section-header">CLASSIFICA TOTALE GIOCATORI</div>
                <div class="table-responsive">
                    <table class="table-stats mb-0">
                        <thead>
                            <tr>
                                <th>Pos</th>
                                <th>Giocatore</th>
                                <th>Ruolo</th>
                                <th>GP</th>
                                <th>PTS</th>
                                <th>AVG</th>
                                <th>RIM</th>
                                <th>RPG</th>
                                <th>AST</th>
                                <th>APG</th>
                                <th>REC</th>
                                <th>STP</th>
                                <th>FAL</th>
                                <th>Eval</th>
                                <th>MVP</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var rank = 1;
                            }
                            @foreach (var s in seasonStats.OrderByDescending(s => s.TotalPoints))
                            {
                                <tr class="@(rank == 1 ? "highlight-row" : "")">
                                    <td>
                                        @if (rank == 1) { <span class="badge-mvp">TOP</span> }
                                        else { <span>@rank</span> }
                                    </td>
                                    <td class="fw-bold">@s.PlayerName</td>
                                    <td>#@s.JerseyNumber</td>
                                    <td>@s.GamesPlayed</td>
                                    <td class="fw-bold">@s.TotalPoints</td>
                                    <td>@s.AvgPoints.ToString("F1")</td>
                                    <td>@s.TotalRebounds</td>
                                    <td>@s.AvgRebounds.ToString("F1")</td>
                                    <td>@s.TotalAssists</td>
                                    <td>@s.AvgAssists.ToString("F1")</td>
                                    <td>@s.TotalSteals</td>
                                    <td>@s.TotalBlocks</td>
                                    <td>@s.TotalFouls</td>
                                    <td class="fw-bold text-primary">@s.AvgEval.ToString("F1")</td>
                                    <td>—</td>
                                </tr>
                                rank++;
                            }
                            @if (!seasonStats.Any())
                            {
                                <tr><td colspan="15" class="text-center text-muted py-4">Nessun dato disponibile</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-4">
        <div class="col-6 col-md-3">
            <div class="card-stat text-center">
                <span class="stat-label">MIGLIOR MARCATORE</span>
                @if (seasonStats.Any())
                {
                    var top = seasonStats.OrderByDescending(x => x.TotalPoints).First();
                    <span class="stat-value text-primary d-block mt-2">@top.PlayerName</span>
                    <span class="text-stat-sm">@top.TotalPoints PTS</span>
                }
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card-stat text-center">
                <span class="stat-label">MIGLIOR RIMBALZISTA</span>
                @if (seasonStats.Any())
                {
                    var top = seasonStats.OrderByDescending(x => x.TotalRebounds).First();
                    <span class="stat-value text-primary d-block mt-2">@top.PlayerName</span>
                    <span class="text-stat-sm">@top.TotalRebounds RIM</span>
                }
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card-stat text-center">
                <span class="stat-label">MIGLIOR ASSISTMAN</span>
                @if (seasonStats.Any())
                {
                    var top = seasonStats.OrderByDescending(x => x.TotalAssists).First();
                    <span class="stat-value text-primary d-block mt-2">@top.PlayerName</span>
                    <span class="text-stat-sm">@top.TotalAssists AST</span>
                }
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card-stat text-center">
                <span class="stat-label">VALUTAZIONE MEDIA</span>
                @if (seasonStats.Any())
                {
                    var top = seasonStats.OrderByDescending(x => x.AvgEval).First();
                    <span class="stat-value text-primary d-block mt-2">@top.PlayerName</span>
                    <span class="text-stat-sm">@(top.AvgEval.ToString("F1"))</span>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool loading = true;
    private List<PlayerMatchStats> allStats = new();
    private List<PlayerMatchStats> filteredStats = new();
    private List<PlayerSeasonStats> seasonStats = new();
    private List<Player> players = new();
    private List<Match> allMatches = new();
    private int filterPlayerId;
    private int filterMatchId;

    private int chartPlayerId;
    private int chartMatchId;
    private List<Shot> shotChartShots = new();
    private List<(string Label, string Value, string Color)> pctCards = new();

    protected override async Task OnInitializedAsync()
    {
        allStats = await StatsService.GetAllStatsAsync();
        filteredStats = allStats;
        seasonStats = await StatsService.GetSeasonStatsAsync();
        players = await PlayerService.GetAllAsync();
        allMatches = await MatchService.GetAllAsync();

        chartPlayerId = players.FirstOrDefault()?.Id ?? 0;
        await LoadShotChart();

        loading = false;
    }

    private async Task LoadShotChart()
    {
        if (chartPlayerId == 0)
        {
            shotChartShots = new();
            pctCards = new();
            return;
        }

        int? matchId = chartMatchId == 0 ? null : chartMatchId;
        shotChartShots = await StatsService.GetShotsByPlayerAsync(chartPlayerId, matchId);
        var pct = await StatsService.GetShootingPercentagesAsync(chartPlayerId, matchId);
        pctCards = new List<(string, string, string)>
        {
            ($"FG {pct.FieldGoalsMade}/{pct.FieldGoalsAttempted}", pct.FieldGoalPct.ToString("F1") + "%", "#FF7A00"),
            ($"3P {pct.ThreePointersMade}/{pct.ThreePointersAttempted}", pct.ThreePointPct.ToString("F1") + "%", "#0DCAF0"),
            ($"2P {pct.TwoPointersMade}/{pct.TwoPointersAttempted}", pct.TwoPointPct.ToString("F1") + "%", "#20C997"),
            ($"FT {pct.FreeThrowsMade}/{pct.FreeThrowsAttempted}", pct.FreeThrowPct.ToString("F1") + "%", "#FFC107"),
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
    }

    private async Task ApplyFilters()
    {
        var query = allStats.AsEnumerable();
        if (filterPlayerId > 0) query = query.Where(s => s.PlayerId == filterPlayerId);
        if (filterMatchId > 0) query = query.Where(s => s.MatchId == filterMatchId);
        filteredStats = query.ToList();
    }
}
